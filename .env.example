# ==============================================================================
# Desktop Copilot - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# NOTE: The system is designed to run in offline/local "mock" mode out-of-the-box
# if no API keys are provided. Add your real keys below to enable live providers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UI & Renderer Settings
# ------------------------------------------------------------------------------
# The URL where the Vite overlay/HUD development server is running
RENDERER_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. General API Keys (Shorthand Providers)
# ------------------------------------------------------------------------------
# If set, services will automatically detect and configure providers:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 3. Chat / Question Answering Capabilities
# ------------------------------------------------------------------------------
# Provider: 'openai' | 'gemini' | 'anthropic' | 'mock'
AI_CHAT_PROVIDER=mock
# Arbitrary model name (e.g., 'gemini-3.8-flash', 'gemini-4-argon', 'gpt-4o', 'claude-3-7-sonnet')
AI_CHAT_MODEL=gemini-3.8-flash
AI_CHAT_API_KEY=local
# Optional custom endpoint (e.g., Azure OpenAI, custom proxy, vLLM / Ollama)
AI_CHAT_ENDPOINT=
# Sampling temperature (0.0 to 1.0)
AI_CHAT_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 4. Vision / Screen Reading Capabilities
# ------------------------------------------------------------------------------
# Provider: 'openai' | 'gemini' | 'anthropic' | 'mock'
AI_VISION_PROVIDER=mock
AI_VISION_MODEL=custom-vision-model
AI_VISION_API_KEY=local
AI_VISION_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. Speech-to-Text (STT) / Voice Listening Capabilities
# ------------------------------------------------------------------------------
# Provider: 'deepgram' | 'openai' | 'mock'
AI_STT_PROVIDER=mock
AI_STT_MODEL=custom-stt-model
AI_STT_API_KEY=local
AI_STT_ENDPOINT=

# ------------------------------------------------------------------------------
# 6. Global Shortcuts (Optional Overrides)
# ------------------------------------------------------------------------------
HOTKEY_PRIVACY_TOGGLE=CommandOrControl+Shift+H
HOTKEY_INTERACTIVE_TOGGLE=CommandOrControl+Shift+I
HOTKEY_DEMO_TRIGGER=CommandOrControl+Shift+T
